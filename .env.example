# Copy to .env and adjust. All values are optional (defaults shown).

# ---- Central database ----
POSTGRES_USER=forensic
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forensic

# ---- Published ports ----
FORENSIC_PORT=8005
DETECTION_PORT=8000

# ---- Object detection ----
# File inside services/detection/models/
DETECTION_MODEL=yolo11s.pt
DETECTION_CONFIDENCE=0.35
# Comma separated, empty = all classes (e.g. person,car,truck)
DETECTION_CLASSES=
DETECTION_CAMERA_NAME=Main entrance camera
DETECTION_CAMERA_ZONE=entrance

# ---- License plate recognition ----
# Relative to services/lpr/
LPR_VIDEO_PATH=data/videos/sample_10s.mp4
LPR_CAMERA_NAME=Parking gate camera
LPR_CAMERA_ZONE=gate
# Recording start time (ISO 8601). Empty = time of the run.
LPR_VIDEO_START_TS=
